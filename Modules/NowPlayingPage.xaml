<UserControl x:Class="EndfieldHud.Modules.NowPlayingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Width="280" Height="280" VerticalAlignment="Center"
                Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Image x:Name="Art" Stretch="UniformToFill"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0,0,0">
            <TextBlock x:Name="SourceText" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="TitleText" FontSize="30" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,6,0,4"/>
            <TextBlock x:Name="ArtistText" FontSize="16" Foreground="{StaticResource DimBrush}"/>

            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button Content="&#xE892;" Style="{StaticResource HudButton}"
                        FontFamily="{StaticResource IconFont}" FontSize="20" Width="56" Height="48"
                        Click="Prev_Click"/>
                <Button x:Name="PlayButton" Content="&#xE768;" Style="{StaticResource HudButton}"
                        FontFamily="{StaticResource IconFont}" FontSize="20" Width="56" Height="48"
                        Margin="8,0" Click="Play_Click"/>
                <Button Content="&#xE893;" Style="{StaticResource HudButton}"
                        FontFamily="{StaticResource IconFont}" FontSize="20" Width="56" Height="48"
                        Click="Next_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
