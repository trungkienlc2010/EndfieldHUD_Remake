<Window x:Class="EndfieldHud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EndfieldHUD" Width="1100" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">

    <Border x:Name="PanelRoot"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PanelScale"/>
                <TranslateTransform x:Name="PanelShift"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thanh bên: điều hướng + nút nguồn -->
            <Border Grid.RowSpan="2" Background="{StaticResource BgBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource HudButton}"
                            Margin="10" Height="44"
                            Content="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="18"
                            Foreground="{StaticResource DangerBrush}"
                            ToolTip="Thoát EndfieldHUD" Click="Power_Click"/>
                    <StackPanel x:Name="NavPanel" Margin="0,64,0,0"/>
                </DockPanel>
            </Border>

            <!-- Thanh trên: tiêu đề + đồng hồ -->
            <Border Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ENDFIELD" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="  //  " Foreground="{StaticResource DimBrush}"/>
                        <TextBlock x:Name="TitleText"/>
                    </StackPanel>
                    <TextBlock x:Name="ClockText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource DimBrush}"/>
                </Grid>
            </Border>
            <Rectangle Grid.Column="1" Height="3" Width="120" VerticalAlignment="Top"
                       HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}"/>

            <!-- Nội dung module -->
            <ContentControl x:Name="Host" Grid.Column="1" Grid.Row="1" IsTabStop="False"/>
        </Grid>
    </Border>
</Window>
